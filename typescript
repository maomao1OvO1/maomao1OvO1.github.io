<html>

<head>

<meta charset="UTF-8">

<title>♟️ 国际象棋</title>


<style>

body{

text-align:center;

font-family:Arial;

}


/* ===== 返回小游戏按钮 ===== */

.back-home{

position:fixed;

top:20px;

right:20px;

background:#e5dcff;

color:#6543a5;

padding:10px 15px;

border-radius:20px;

text-decoration:none;

font-size:16px;

}



/* ===== 棋盘 ===== */

#board{

width:400px;

height:400px;

margin:30px auto;

display:grid;

grid-template-columns:repeat(8,1fr);

border-radius:15px;

overflow:hidden;

}



.cell{

width:50px;

height:50px;

display:flex;

justify-content:center;

align-items:center;

font-size:36px;

cursor:pointer;

box-sizing:border-box;

}



.light{

background:#f0d9b5;

}



.dark{

background:#b58863;

}



.select{

outline:4px solid #6543a5;

}



button{

padding:10px 20px;

border:none;

border-radius:20px;

margin:5px;

cursor:pointer;

font-size:16px;

}


</style>

</head>


<body>


<a href="../games.html" class="back-home">

🎮 返回小游戏

</a>


<h1>♟️ 国际象棋</h1>


<button onclick="setMode('player')">

双人模式

</button>


<button onclick="setMode('ai')">

AI模式

</button>


<p id="info">

白方回合

</p>


<div id="board"></div>


<button onclick="restart()">

重新开始

</button>

<script>

// ===== 国际象棋 JS v2 =====


// 棋盘

let board = [];


// 当前回合

let turn = "white";


// 模式

let mode = "player";


// ===== 游戏模式切换 =====

function setMode(m){

    mode = m;


    if(mode=="ai"){

        document.getElementById("info").innerHTML =
        "AI模式";

    }
    else{

        document.getElementById("info").innerHTML =
        "双人模式";

    }

}


// 选择的棋子

let selected = null;


// 游戏结束

let gameEnd = false;



// ===== 初始棋盘 =====

const startBoard = [

["♜","♞","♝","♛","♚","♝","♞","♜"],

["♟","♟","♟","♟","♟","♟","♟","♟"],

["","","","","","","",""],

["","","","","","","",""],

["","","","","","","",""],

["","","","","","","",""],

["♙","♙","♙","♙","♙","♙","♙","♙"],

["♖","♘","♗","♕","♔","♗","♘","♖"]

];




// ===== 开始游戏 =====

function restart(){


    board = JSON.parse(JSON.stringify(startBoard));


    turn="white";


    selected=null;


    gameEnd=false;


    document.getElementById("info").innerHTML=

    "白方回合";


    draw();


}




// ===== 绘制棋盘 =====

function draw(){


    let box=document.getElementById("board");


    box.innerHTML="";



    for(let x=0;x<8;x++){


        for(let y=0;y<8;y++){


            let cell=document.createElement("div");


            cell.className=

            "cell "

            +

            ((x+y)%2==0?

            "light":

            "dark");



            cell.innerHTML=board[x][y];



            cell.onclick=function(){


                clickCell(x,y);


            };



            box.appendChild(cell);


        }


    }


}




// ===== 点击棋盘 =====

function clickCell(x,y){


    if(gameEnd)return;



    if(selected==null){


        let p=board[x][y];


        if(

        p!="" &&

        color(p)==turn

        ){


            selected=[x,y];


        }


    }

    else{


        tryMove(

        selected[0],

        selected[1],

        x,

        y

        );


        selected=null;


        draw();


    }


}




// ===== 判断颜色 =====

function color(p){


    if(

    "♙♖♘♗♕♔".includes(p)

    ){

        return "white";

    }


    return "black";


}




// ===== 启动 =====

restart();

// ===== 移动棋子 =====

function tryMove(x1,y1,x2,y2){


    let piece=board[x1][y1];


    if(piece=="") return;



    // ===== 正规合法移动判断 =====

if(!isLegalMove(x1,y1,x2,y2)){

    return;

