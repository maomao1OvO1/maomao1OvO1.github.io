    let can=false;



    for(let m of moves){


        if(

        m[0]==x2 &&

        m[1]==y2

        ){

            can=true;

        }


    }



    if(!can){

        return false;

    }



    // 模拟后不能让自己的王被攻击

if(simulateMove(x1,y1,x2,y2)){

    return false;

}




    return true;


}


