            }

            else{


                // 可以吃敌方棋子

                if(

                color(board[nx][ny])

                !=

                color(board[x][y])

                ){


                    arr.push([nx,ny]);


                }



                // 被挡住停止

                break;


            }



            nx+=d[0];

            ny+=d[1];


        }


    }


}




// ===== 兵移动 =====

function pawnMove(arr,x,y,p){


    let dir;


    // 白兵向上

    if(p=="♙"){


        dir=-1;


    }

    // 黑兵向下

    else{


        dir=1;


    }





    // 前进一步

    if(

    board[x+dir] &&

    board[x+dir][y]==""

    ){


        arr.push([x+dir,y]);


    }




    // 初始两步

    if(

    (p=="♙" && x==6)

    ||

    (p=="♟" && x==1)

    ){



        if(

        board[x+dir][y]=="" &&

        board[x+dir*2][y]==""

        ){


            arr.push([x+dir*2,y]);


        }


    }





    // 斜着吃子

    for(let dy of [-1,1]){


        let nx=x+dir;

        let ny=y+dy;



        if(

        board[nx] &&

        board[nx][ny] &&

        board[nx][ny]!="" &&

        color(board[nx][ny])!=color(p)

        ){


            arr.push([nx,ny]);


        }


    }



}

// ===== 特殊规则数据 =====

// 记录棋子是否移动过

let moved = {

    whiteKing:false,

    blackKing:false,

    whiteLeftRook:false,

    whiteRightRook:false,

    blackLeftRook:false,

    blackRightRook:false

};


// 记录上一手

let lastMove=null;




// ===== 王车易位 =====

function castleMove(x1,y1,x2,y2,p){


    // 白王

    if(

    p=="♔" &&

    !moved.whiteKing &&

    x1==7 &&

    y1==4

    ){



        // 王翼

        if(

        x2==7 &&

        y2==6 &&

        board[7][5]=="" &&

        board[7][6]==""

        ){


            board[7][5]=board[7][7];

            board[7][7]="";


            return true;

        }



        // 后翼

        if(

        x2==7 &&

        y2==2 &&

        board[7][1]=="" &&

        board[7][2]=="" &&

        board[7][3]==""

        ){


            board[7][3]=board[7][0];

            board[7][0]="";


            return true;

        }


    }




    // 黑王

    if(

    p=="♚" &&

    !moved.blackKing &&

    x1==0 &&

    y1==4

    ){



        if(

        x2==0 &&

        y2==6 &&

        board[0][5]=="" &&

        board[0][6]==""

        ){


            board[0][5]=board[0][7];

            board[0][7]="";


            return true;

        }




        if(

        x2==0 &&

        y2==2 &&

        board[0][1]=="" &&

        board[0][2]=="" &&

        board[0][3]==""

        ){


            board[0][3]=board[0][0];

            board[0][0]="";


            return true;

        }


    }


    return false;


}





// ===== 兵升变 =====

function promotion(x,y){


    if(board[x][y]=="♙" && x==0){


        let c=prompt(

        "兵升变 Q后 R车 B象 N马"

        );


        if(c=="R")

        board[x][y]="♖";


        else if(c=="B")

        board[x][y]="♗";


        else if(c=="N")

        board[x][y]="♘";


        else

        board[x][y]="♕";


    }



    if(board[x][y]=="♟" && x==7){


        let c=prompt(

        "兵升变 Q后 R车 B象 N马"

        );


        if(c=="R")

        board[x][y]="♜";


        else if(c=="B")

        board[x][y]="♝";


        else if(c=="N")

        board[x][y]="♞";


        else

        board[x][y]="♛";


    }


}


// ===== 查找王的位置 =====

function findKing(side){

    let king = side=="white" ? "♔" : "♚";


    for(let x=0;x<8;x++){

        for(let y=0;y<8;y++){

            if(board[x][y]==king){

                return [x,y];

            }

        }

    }


    return null;

}



// ===== 判断位置是否被攻击 =====

function isAttacked(x,y,side){


    for(let i=0;i<8;i++){

        for(let j=0;j<8;j++){


            let p=board[i][j];


            if(
            p=="" ||
            color(p)==side
            ){

                continue;

            }



            // 马攻击

            if(p=="♘" || p=="♞"){

                let horse=[
                [-2,-1],[-2,1],
                [-1,-2],[-1,2],
                [1,-2],[1,2],
                [2,-1],[2,1]
                ];


                for(let h of horse){

                    if(
                    i+h[0]==x &&
                    j+h[1]==y
                    ){

                        return true;

                    }

                }

            }



            // 王攻击

            if(p=="♔" || p=="♚"){

                if(
                Math.abs(i-x)<=1 &&
                Math.abs(j-y)<=1
                ){

                    return true;

                }

            }



            // 兵攻击

            if(p=="♙"){

                if(
                i-1==x &&
                Math.abs(j-y)==1
                ){

                    return true;

                }

            }


            if(p=="♟"){

                if(
                i+1==x &&
                Math.abs(j-y)==1
                ){

                    return true;

                }

            }



            // 车、象、后攻击

            let dx=x-i;

            let dy=y-j;


            // 车/后

            if(
            dx==0 ||
            dy==0
            ){

                if(
                p=="♖" ||
                p=="♜" ||
                p=="♕" ||
                p=="♛"
                ){

                    return true;

                }

            }



            // 象/后

            if(
            Math.abs(dx)==Math.abs(dy)
            ){

                if(
                p=="♗" ||
                p=="♝" ||
                p=="♕" ||
                p=="♛"
                ){

                    return true;

                }

            }



        }

    }


    return false;

}


// ===== 检查将军 =====

function check(){

    let kingPos=findKing(turn);


    if(!kingPos){

        return true;

    }


    return isAttacked(

        kingPos[0],

        kingPos[1],

        turn

    );

}


// ===== 模拟移动 =====

function simulateMove(x1,y1,x2,y2){


    let old = board[x2][y2];


    let piece = board[x1][y1];


    // 模拟移动

    board[x2][y2]=piece;

    board[x1][y1]="";


    // 检查王是否安全

    let result = check();



    // 恢复棋盘

    board[x1][y1]=piece;

    board[x2][y2]=old;



    return result;

}



// ===== 判断合法移动 =====

function isLegalMove(x1,y1,x2,y2){


    let piece = board[x1][y1];


    // 必须是自己的棋子

    if(color(piece)!=turn){

        return false;

    }



    // 检查棋子本身能不能走

    let moves=getMoves(x1,y1);


    let can=false;



    for(let m of moves){


        if(

        m[0]==x2 &&

        m[1]==y2

        ){

            can=true;

        }


    }



    if(!can){

        return false;

    }



    // 模拟后不能让自己的王被攻击

if(simulateMove(x1,y1,x2,y2)){

    return false;

}




    return true;


}


// ===== 简单AI =====

function aiMove(){


    let moves=[];


    // 找黑棋所有合法移动

    for(let x=0;x<8;x++){

        for(let y=0;y<8;y++){


            let p=board[x][y];


            if(
            p!="" &&
            color(p)=="black"
            ){


                let possible=getMoves(x,y);


                for(let m of possible){


                    if(
                    isLegalMove(x,y,m[0],m[1])
                    ){


                        moves.push({

                            from:[x,y],

                            to:m

                        });


                    }

                }


            }


        }

    }



    if(moves.length==0){

        return;

    }



    // 优先吃子

    let eat=moves.filter(function(m){

        return board[m.to[0]][m.to[1]]!="";

    });



    if(eat.length>0){

        moves=eat;

    }



    // 随机选择

    let move=
    moves[
    Math.floor(Math.random()*moves.length)
    ];



    tryMove(

        move.from[0],

        move.from[1],

        move.to[0],

        move.to[1]

    );


}


