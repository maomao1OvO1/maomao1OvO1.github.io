#board{

width:400px;

height:400px;

margin:30px auto;

display:grid;

grid-template-columns:repeat(8,1fr);

border-radius:15px;

overflow:hidden;

}



.cell{

width:50px;

height:50px;

display:flex;

justify-content:center;

align-items:center;

font-size:36px;

cursor:pointer;

box-sizing:border-box;

}



.light{

background:#f0d9b5;

}



.dark{

background:#b58863;

}



