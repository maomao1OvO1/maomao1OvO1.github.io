<!DOCTYPE html>
<html lang="zh-CN">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>🎮 手柄测试</title>

<style>

body{
    margin:0;
    padding:25px;
    text-align:center;
    font-family:Arial,sans-serif;
    background:#f5f5f5;
}

h1{
    margin-bottom:10px;
}

#status{
    margin:15px;
    font-size:18px;
}

#device{
    color:#666;
    font-size:14px;
    word-break:break-all;
}

.controller{
    max-width:500px;
    margin:25px auto;
    padding:25px;
    background:white;
    border-radius:25px;
    box-shadow:0 5px 20px #0002;
}

.row{
    display:flex;
    justify-content:space-around;
    align-items:center;
    margin:20px 0;
}

.key{
    width:55px;
    height:55px;
    border-radius:50%;
    background:#ddd;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:bold;
    margin:5px;
    transition:0.05s;
}

.key.pressed{
    background:#555;
    color:white;
    transform:scale(1.12);
}

.trigger{
    width:110px;
    height:20px;
    background:#ddd;
    border-radius:10px;
    overflow:hidden;
}

.trigger-fill{
    width:0%;
    height:100%;
    background:#555;
}

.stick{
    width:120px;
    height:120px;
    border-radius:50%;
    background:#ddd;
    position:relative;
    margin:auto;
}

.stick-dot{
    width:25px;
    height:25px;
    border-radius:50%;
    background:#555;
    position:absolute;
    left:47px;
    top:47px;
}

.value{
    font-size:13px;
    margin-top:8px;
    color:#666;
}

button{
    padding:12px 20px;
    margin:8px;
    border:none;
    border-radius:12px;
    font-size:16px;
}

</style>

</head>

<body>

<h1>🎮 手柄测试</h1>

<div id="status">
请连接手柄，然后按任意普通按键
</div>

<div id="device"></div>


<div class="controller">

<h2>📳 手柄震动</h2>

<div style="margin:20px;">

    <p>
        左/强震动时间：
        <input
            id="strongTime"
            type="number"
            min="0.1"
            step="0.1"
            value="1"
            style="width:70px;padding:8px;"
        >
        秒
    </p>

    <p>
        右/弱震动时间：
        <input
            id="weakTime"
            type="number"
            min="0.1"
            step="0.1"
            value="1"
            style="width:70px;padding:8px;"
        >
        秒
    </p>

    <button onclick="vibrateStrong()">
        左振动
    </button>

    <button onclick="vibrateWeak()">
        右振动
    </button>

    <br>

    <button onclick="vibrateBoth()">
        左右同时振动
    </button>

    <button onclick="stopGamepadVibration()">
        停止
    </button>

</div>

<!-- 肩键 -->

<div class="row">

<div>
    <b>LB</b>
    <div id="b4" class="key">LB</div>
</div>

<div>
    <b>RB</b>
    <div id="b5" class="key">RB</div>
</div>

</div>


<!-- 扳机 -->

<div class="row">

<div>

    <b>LT</b>

    <div class="trigger">
        <div id="lt"
             class="trigger-fill"></div>
    </div>

    <div id="ltValue"
         class="value">
         0%
    </div>

</div>


<div>

    <b>RT</b>

    <div class="trigger">
        <div id="rt"
             class="trigger-fill"></div>
    </div>

    <div id="rtValue"
         class="value">
         0%
    </div>

</div>

</div>


<!-- ABXY -->

<div class="row">

<div>

<div id="b2" class="key">X</div>

</div>

<div>

<div id="b3" class="key">Y</div>

</div>

<div>

<div id="b1" class="key">B</div>

</div>

<div>

<div id="b0" class="key">A</div>

</div>

</div>


<!-- 摇杆 -->

<div class="row">

<div>

<h3>左摇杆</h3>

<div class="stick">

<div id="leftDot"
     class="stick-dot">
</div>

</div>

<div id="leftValue"
     class="value">
X 0.00<br>
Y 0.00
</div>

</div>


<div>

<h3>右摇杆</h3>

<div class="stick">

<div id="rightDot"
     class="stick-dot">
</div>

</div>

<div id="rightValue"
     class="value">
X 0.00<br>
Y 0.00
</div>

</div>

</div>


<!-- 十字键 -->

<h3>十字键</h3>

<div class="row">

<div id="b12" class="key">↑</div>

</div>

<div class="row">

<div id="b14" class="key">←</div>

<div id="b13" class="key">↓</div>

<div id="b15" class="key">→</div>

</div>


<!-- Start Select -->

<div class="row">

<div id="b8" class="key">☰</div>

<div id="b9" class="key">≡</div>

</div>

</div>


<div class="controller">

<h2>🧭 手柄陀螺仪</h2>

<p id="gyroStatus">
正在检测……
</p>

<div class="value">
陀螺仪 X：
<span id="gyroX">0</span>
</div>

<div class="value">
陀螺仪 Y：
<span id="gyroY">0</span>
</div>

<div class="value">
陀螺仪 Z：
<span id="gyroZ">0</span>
</div>

<div class="value">
旋转 X：
<span id="rotationX">0</span>
</div>

<div class="value">
旋转 Y：
<span id="rotationY">0</span>
</div>

<div class="value">
旋转 Z：
<span id="rotationZ">0</span>
</div>

</div>


<button onclick="location.href='../index.html'">
← 返回大厅
</button>


<script>

alert("JS运行了");

let gamepad = null;


// ============================
// 手柄连接
// ============================

window.addEventListener(
    "gamepadconnected",
    event => {

        gamepad = event.gamepad;

        document.getElementById(
            "status"
        ).textContent =
            "🎮 手柄已连接";

        document.getElementById(
            "device"
        ).textContent =
            gamepad.id;

    }
);


// ============================
// 手柄断开
// ============================

window.addEventListener(
    "gamepaddisconnected",
    () => {

        gamepad = null;

        document.getElementById(
            "status"
        ).textContent =
            "手柄已断开";

        document.getElementById(
            "device"
        ).textContent = "";

    }
);


// ============================
// 手柄震动
// ============================

function getVibrationActuator(){

    if(!gamepad) return null;

    const pads = navigator.getGamepads();
    const pad = pads[gamepad.index];

    if(!pad) return null;

    if(!pad.vibrationActuator){
        alert("这个手柄不支持网页震动");
        return null;
    }

    return pad.vibrationActuator;
}


// 左 / 强震动
function vibrateStrong(){

    const actuator =
        getVibrationActuator();

    if(!actuator) return;

    const seconds =
        Number(
            document.getElementById(
                "strongTime"
            ).value
        );

    actuator.playEffect(
        "dual-rumble",
        {
            duration: seconds * 1000,

            startDelay: 0,

            strongMagnitude: 1.0,

            weakMagnitude: 0
        }
    );
}


// 右 / 弱震动
function vibrateWeak(){

    const actuator =
        getVibrationActuator();

    if(!actuator) return;

    const seconds =
        Number(
            document.getElementById(
                "weakTime"
            ).value
        );

    actuator.playEffect(
        "dual-rumble",
        {
            duration: seconds * 1000,

            startDelay: 0,

            strongMagnitude: 0,

            weakMagnitude: 1.0
        }
    );
}


// 左右同时震
function vibrateBoth(){

    const actuator =
        getVibrationActuator();

    if(!actuator) return;

    const strong =
        Number(
            document.getElementById(
                "strongTime"
            ).value
        );

    const weak =
        Number(
            document.getElementById(
                "weakTime"
            ).value
        );

    const duration =
        Math.max(
            strong,
            weak
        ) * 1000;

    actuator.playEffect(
        "dual-rumble",
        {
            duration: duration,

            startDelay: 0,

            strongMagnitude: 1.0,

            weakMagnitude: 1.0
        }
    );
}


// 停止
function stopGamepadVibration(){

    const actuator =
        getVibrationActuator();

    if(!actuator) return;

    actuator.reset();

}


// ============================
// 按钮更新
// ============================

function updateButton(index){

    const pads =
        navigator.getGamepads();

    if(!gamepad) return;

    const pad =
        pads[gamepad.index];

    if(!pad) return;

    const element =
        document.getElementById(
            "b" + index
        );

    if(!element) return;

    if(pad.buttons[index]?.pressed){

        element.classList.add(
            "pressed"
        );

    }else{

        element.classList.remove(
            "pressed"
        );

    }

}


// ============================
// 摇杆
// ============================

function updateStick(
    x,
    y,
    dotId,
    valueId
){

    const pads =
        navigator.getGamepads();

    if(!gamepad) return;

    const pad =
        pads[gamepad.index];

    if(!pad) return;

    let px =
        pad.axes[x] || 0;

    let py =
        pad.axes[y] || 0;


    const dot =
        document.getElementById(
            dotId
        );

    dot.style.left =
        (47 + px * 45) + "px";

    dot.style.top =
        (47 + py * 45) + "px";


    document.getElementById(
        valueId
    ).innerHTML =
        "X " + px.toFixed(2) +
        "<br>Y " + py.toFixed(2);

}


// ============================
// 扳机
// ============================

function updateTrigger(
    index,
    fillId,
    valueId
){

    const pads =
        navigator.getGamepads();

    if(!gamepad) return;

    const pad =
        pads[gamepad.index];

    if(!pad) return;


    let value =
        pad.buttons[index]?.value || 0;


    document.getElementById(
        fillId
    ).style.width =
        (value * 100) + "%";


    document.getElementById(
        valueId
    ).textContent =
        Math.round(
            value * 100
        ) + "%";

}


function updateGyro(pad){

    // 检查浏览器有没有提供扩展传感器数据

    if(
        pad &&
        pad.pose
    ){

        const pose = pad.pose;

        document.getElementById("gyroStatus")
            .textContent =
            "🧭 检测到手柄扩展数据";

        if(pose.angularVelocity){

            document.getElementById("rotationX")
                .textContent =
                pose.angularVelocity[0].toFixed(3);

            document.getElementById("rotationY")
                .textContent =
                pose.angularVelocity[1].toFixed(3);

            document.getElementById("rotationZ")
                .textContent =
                pose.angularVelocity[2].toFixed(3);

        }

        if(pose.linearVelocity){

            document.getElementById("gyroX")
                .textContent =
                pose.linearVelocity[0].toFixed(3);

            document.getElementById("gyroY")
                .textContent =
                pose.linearVelocity[1].toFixed(3);

            document.getElementById("gyroZ")
                .textContent =
                pose.linearVelocity[2].toFixed(3);

        }

    }else{

        document.getElementById("gyroStatus")
            .textContent =
            "❌ Chrome 没有通过 Gamepad API 提供陀螺仪数据";

    }

}


// ============================
// 主循环
// ============================

function update(){

    if(gamepad){

        // 普通按钮

        for(let i = 0; i < 16; i++){

            updateButton(i);

        }


        // 摇杆

        updateStick(
            0,
            1,
            "leftDot",
            "leftValue"
        );

        updateStick(
            2,
            3,
            "rightDot",
            "rightValue"
        );


        // 扳机

        updateTrigger(
            6,
            "lt",
            "ltValue"
        );

        updateTrigger(
            7,
            "rt",
            "rtValue"
        );

    }

  // 🧭 陀螺仪

        const pads =
            navigator.getGamepads();

        const pad =
            pads[gamepad.index];

        if(pad){

            updateGyro(pad);

        }

    }


    requestAnimationFrame(update);

}

update();

</script>

</body>

</html>
